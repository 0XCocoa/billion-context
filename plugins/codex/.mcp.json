{
  "mcpServers": {
    "bili": {
      "command": "node",
      "args": [
        "./mcp-server.mjs"
      ],
      "env_vars": [
        "BILI_MCP_PROXY",
        "BILI_CONVERSATION_ID",
        "PATH",
        "APPDATA",
        "LOCALAPPDATA",
        "USERPROFILE",
        "HOME"
      ],
      "startup_timeout_sec": 30
    }
  }
}
